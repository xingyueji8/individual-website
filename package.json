    "test:organize": "node tests/run.mjs organize",
    "test:photos": "node tests/run.mjs photos",
    "test:pdf": "node tests/run.mjs pdf",
    "test:mobile": "node tests/run.mjs mobile",
    "test:mobile-media": "node tests/run.mjs mobile-media",
    "test:background": "node tests/run.mjs background",
    "test:agent": "node tests/run.mjs agent",
    "test:shares": "node tests/run.mjs shares",
    "test:space": "node tests/run.mjs space",
    "test:build": "node tests/run.mjs build",
