{
  "name": "xingyueji",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "build:assets": "node scripts/prepare-heic.mjs",
    "dev": "wrangler dev",
    "check": "node --check src/worker.js && wrangler deploy --dry-run",
    "test:studio": "node test/studio-ui.mjs",
    "test:access": "node test/guest-mode-access.mjs",
    "test:upload": "node test/resumable-upload.mjs",
    "test:glass": "node test/glass-motion.mjs",
    "test:i18n": "node test/i18n.mjs",
    "test:organize": "node test/content-organize.mjs && node test/organize-ui.mjs",
    "test:background": "node test/entry-background.mjs && node test/entry-background-ui.mjs",
    "test:agent": "node test/site-agent.mjs && node test/site-agent-ui.mjs && node test/site-agent-interactions.mjs && node test/site-agent-visibility.mjs",
    "test:shares": "node test/shares.mjs && node test/shares-ui.mjs",
    "test": "npm run test:studio && npm run test:glass && npm run test:i18n && npm run test:access && npm run test:upload && npm run test:organize && npm run test:background && npm run test:agent && npm run test:shares && npm run test:space",
    "deploy": "wrangler deploy",
    "test:space": "node test/personal-space.mjs"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "wrangler": "^4.30.0"
  },
  "dependencies": {
    "heic-to": "1.5.2"
  }
}
